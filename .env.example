# Database (PostgreSQL — Supabase or Neon)
# Pooled connection, used by the app at runtime:
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection, used by `prisma db push` / migrations only:
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in via NextAuth (Google Cloud Console -> Credentials -> OAuth client ID)
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email/password sign-up (currently disabled in the UI — no email provider set up) ---
# Set to "true" once RESEND_API_KEY / EMAIL_FROM below are configured, to bring back
# the email/password form on the login and signup pages.
NEXT_PUBLIC_ENABLE_EMAIL_AUTH="false"

# Email (Resend) - verification & password reset. Only needed if the flag above is "true".
# See RESEND_SETUP.md for step-by-step setup
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Must be a domain verified in Resend. The resend.dev default only delivers to
# your own account email, which silently blocks every signup.
EMAIL_FROM="Cain <noreply@cainsat.org>"

# --- Planner push reminders (tasks.cainsat.org) ---
# Fire task reminders when the planner tab is closed. With these unset the
# feature is simply off: the planner falls back to in-tab reminders only.
# Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL or mailto the push services can reach you at.
VAPID_SUBJECT="mailto:admin@cainsat.org"
# Shared secret guarding /api/cron/planner-reminders. Vercel Cron sends it as
# `Authorization: Bearer <this>`; an external pinger can pass `?key=<this>`.
CRON_SECRET="generate-with-openssl-rand-base64-32"
