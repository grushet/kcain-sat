// SAT Learning Platform - Database Schema
// Compatible with PostgreSQL, MySQL, and SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ AUTHENTICATION & USERS ============

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  password       String? // For credentials provider
  timeMultiplier Float     @default(1) // Extended time on the full test: 1, 1.5, or 2
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  progress          UserProgress[]
  xpRecords         XPRecord[]
  streaks           Streak[]
  dailyGoals        DailyGoal[]
  subscription      Subscription?
  questionAnswers   UserQuestionAnswer[]
  testAttempts      TestAttempt[]
  practiceSessions  PracticeSession[]
  plannerTasks      PlannerTask[]
  plannerSettings   PlannerSettings?
  pushSubscriptions PlannerPushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============ LEARNING CONTENT ============

model Section {
  id          String   @id @default(cuid())
  name        String // "Math" | "Reading & Writing"
  description String?  @db.Text
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  units Unit[]
}

model Unit {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  title       String
  description String?  @db.Text
  topic       String // e.g., "Linear Equations", "Evidence-Based Reading"
  difficulty  String // "beginner" | "intermediate" | "advanced"
  durationMin Int      @default(5) // Estimated minutes
  order       Int      @default(0)
  xpReward    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit          Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contentBlocks LessonContent[]
  questions     Question[]
  userProgress  UserProgress[]
}

model LessonContent {
  id       String @id @default(cuid())
  lessonId String
  type     String // "text" | "heading" | "example" | "formula"
  content  String @db.Text
  order    Int    @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

/// One row per distinct question, shared by every student who ever sees it.
/// Collegeboard items are immutable and the local bank is static, so content is
/// stored once here and an attempt only stores the letters a student picked.
/// Snapshotting the HTML per attempt instead would cost 1-3 MB per full test.
model Question {
  id            String   @id @default(cuid())
  /// Stable identity in the question's own source, so the same item is never
  /// stored twice: Collegeboard's `external_id`, or "bank:<id>" for the local
  /// practice bank. Null only for rows created before this column existed.
  externalId    String?  @unique
  /// "collegeboard" | "practice_bank" | "lesson"
  source        String   @default("lesson")
  /// "math" | "rw", where the source says. Null for content that predates it.
  section       String?
  lessonId      String?
  topic         String
  difficulty    String
  /// Collegeboard's skill label, e.g. "Linear equations in one variable".
  skillDesc     String?
  /// The passage or figure a question refers to, kept separate from the stem
  /// because the review UI scrolls it in its own box.
  stimulus      String?  @db.Text
  questionText  String   @db.Text
  questionType  String   @default("multiple_choice") // "multiple_choice" | "grid_in"
  /// JSON array of every accepted answer. Grid-ins legitimately have several
  /// ("2/7" and ".2857" are the same answer), so a single string cannot hold
  /// the key. Read it through parseCorrectAnswers(), which also accepts the
  /// bare string that lesson-era rows would have stored.
  correctAnswer String   @db.Text
  explanation   String?  @db.Text
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  lesson      Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  answers     QuestionAnswer[]
  userAnswers UserQuestionAnswer[]

  @@index([source, section])
  @@index([topic])
}

model QuestionAnswer {
  id         String @id @default(cuid())
  questionId String
  text       String @db.Text
  optionKey  String // "A" | "B" | "C" | "D"
  order      Int    @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ============ USER PROGRESS ============

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  score       Int? // Percentage
  xpEarned    Int       @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// One row per answer a student gave, on any surface. This is the flat log that
/// "which skills am I weakest at" reads; the ordered per-module view that the
/// review screen renders lives on TestModule.
model UserQuestionAnswer {
  id                String   @id @default(cuid())
  userId            String
  questionId        String
  /// "full_test" | "practice" | "lesson"
  source            String   @default("practice")
  /// Set for full-test answers. moduleKey is "rw1" | "rw2" | "math1" | "math2".
  attemptId         String?
  moduleKey         String?
  /// Set for practice answers.
  practiceSessionId String?
  /// Position within its module or practice session, for stable ordering.
  orderIndex        Int?
  /// Null when the student ran out of time or skipped the question.
  selectedAnswer    String?  @db.Text
  isCorrect         Boolean
  timeSpent         Int? // seconds
  answeredAt        DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt         TestAttempt?     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([attemptId])
  @@index([practiceSessionId])
  @@index([questionId])
}

/// Every XP award, one row each. Kept as a ledger rather than a running total on
/// User so an award can be explained back to the student ("+50 personal best"),
/// and so the once-per-day rules are enforced by reading what was already given.
model XPRecord {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  /// See XP_SOURCE in src/lib/xp.ts for the list and what each one is worth.
  source    String
  /// What earned it: a lessonId, a questionId, an attemptId.
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports the "has this already been granted today" check on every award.
  @@index([userId, source, reference, createdAt])
  @@index([userId, createdAt])
}

/// `lastActiveAt` holds UTC midnight of the last study day with any activity, not
/// a wall-clock timestamp, so the gap between two days is exact arithmetic rather
/// than a comparison that drifts with the hour someone happens to study.
model Streak {
  id            String   @id @default(cuid())
  userId        String
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

/// One row per study day per student. `date` is UTC midnight of the calendar date
/// in the app's study timezone, so a student working at 9pm gets credit for that
/// day rather than for tomorrow.
model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  targetXP  Int      @default(30)
  earnedXP  Int      @default(0)
  completed Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ============ TEST & PRACTICE ATTEMPTS ============

/// One sitting of the full practice test. Created the moment the student starts
/// rather than when they finish, so a browser crash two hours in is recoverable
/// instead of total. `status` is what separates a test still being taken from a
/// finished one; only a completed attempt carries scores.
model TestAttempt {
  id     String @id @default(cuid())
  userId String
  /// "in_progress" | "completed" | "abandoned"
  status String @default("in_progress")
  /// The client's phase machine value, so a resumed test lands on the same
  /// screen the student left (mid-module, module break, math intro, results).
  phase  String @default("intro")

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  /// Scores, written once at completion. Raw counts are kept alongside the
  /// scaled ones so the estimate can be recomputed if the curve ever changes.
  rwRaw       Int?
  rwMax       Int?
  mathRaw     Int?
  mathMax     Int?
  rwScaled    Int?
  mathScaled  Int?
  totalScaled Int?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules TestModule[]
  answers UserQuestionAnswer[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

/// One of the four modules of an attempt. Holds the ordered question list and
/// the live answer array, which together are what both the resume path and the
/// review screen read. The flat per-answer rows in UserQuestionAnswer are
/// written from here when the module ends; they exist for querying, not for
/// rendering the module back in order.
model TestModule {
  id        String  @id @default(cuid())
  attemptId String
  /// "rw1" | "rw2" | "math1" | "math2"
  key       String
  order     Int     @default(0)
  /// Whether module 2 was routed to the harder form, which the adaptive test
  /// decides from the module 1 score.
  harder    Boolean @default(false)

  /// Ordered Question.id values, and the answer given at each position.
  /// A null entry is an unanswered question, which is distinct from a wrong one.
  questionIds Json
  answers     Json
  /// Seconds spent on each position, same ordering. Null where untracked.
  times       Json?

  /// Where the student was when the module was last saved, so a resume puts
  /// them back on the right question with the right time remaining.
  currentIndex    Int  @default(0)
  secondsLeft     Int?
  durationSeconds Int  @default(0)

  /// "in_progress" | "completed"
  status   String @default("in_progress")
  rawScore Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, key])
  @@index([attemptId])
}

/// A run through one practice topic. Practice has no finish button and a student
/// can navigate away at any point, so counters are updated per answer rather
/// than written once at the end.
model PracticeSession {
  id         String @id @default(cuid())
  userId     String
  topicSlug  String
  topicLabel String
  /// "all" | "easy" | "medium" | "hard" | "very_hard"
  difficulty String @default("all")

  totalQuestions Int @default(0)
  answered       Int @default(0)
  correct        Int @default(0)

  startedAt    DateTime  @default(now())
  lastActiveAt DateTime  @updatedAt
  completedAt  DateTime?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers UserQuestionAnswer[]

  @@index([userId, startedAt])
}

// ============ MONETIZATION ============

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String // "free" | "premium" | "premium_annual"
  status               String // "active" | "cancelled" | "expired"
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ TASK PLANNER (tasks.cainsat.org) ============

// The planner used to live in its own Firebase project with its own accounts.
// These models bring it onto the same user record as the SAT site so a student
// signs in once.
//
// Dates here are deliberately plain "YYYY-MM-DD" strings, not DateTime. A due
// date is a calendar day, not an instant: storing it as a timestamp forces a
// timezone on it and shifts the day for anyone behind UTC, which is exactly the
// off-by-one the old client kept hitting.

model PlannerTask {
  /// Generated client-side (crypto.randomUUID) so an offline edit keeps its identity.
  id     String @id
  userId String

  text       String
  completed  Boolean @default(false)
  /// "YYYY-MM-DD", or null for an undated task.
  dueDate    String?
  /// "high" | "med" | "low", or null for no priority.
  importance String?

  /// Repeat interval, e.g. n=2 unit="weeks". Both null when the task does not repeat.
  repeatN    Int?
  repeatUnit String?

  /// Local wall-clock "YYYY-MM-DDTHH:mm". Not an instant, for the same reason as dueDate.
  reminder      String?
  reminderFired Boolean @default(false)

  /// Free-text notes. Never drawn in the list, only in the task's own panel.
  description String?

  /// Where the student put this task by hand inside its group, or null while
  /// the sort is deciding. Deliberately not sortOrder: sortOrder is the order
  /// the list happened to be posted in, and a pin has to survive the client
  /// re-sorting by date or importance on top of it.
  pinIndex Int?

  /// Position in the list. The client prepends new tasks, so this descends.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks PlannerSubtask[]

  @@index([userId, sortOrder])
  @@index([userId, dueDate])
}

model PlannerSubtask {
  id     String @id
  taskId String

  text       String
  completed  Boolean @default(false)
  dueDate    String?
  importance String?
  sortOrder  Int     @default(0)

  task PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

// A browser push endpoint the student granted, so a reminder can reach them
// with the tab shut. The client-side checkReminders() only runs while the
// planner is open; this is how a reminder fires otherwise.
//
// One row per browser/profile. `timeZone` is that device's IANA zone, reported
// at subscribe time: the cron compares it against a reminder's wall-clock
// string ("2026-09-01T09:00") to decide whether nine in the morning has
// arrived for this student. Storing it here rather than on PlannerSettings
// keeps each device self-describing and avoids a settings migration.
model PlannerPushSubscription {
  id       String  @id @default(cuid())
  userId   String
  /// The push service URL. Unique so a re-subscribe from the same browser
  /// updates the row instead of piling up duplicates.
  endpoint String  @unique
  /// The subscription's public key and auth secret, base64url, straight from
  /// PushSubscription.toJSON().keys.
  p256dh   String
  auth     String
  /// IANA name, e.g. "America/Toronto". Null falls back to the app default.
  timeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per user: view preferences plus the pomodoro timer.
model PlannerSettings {
  userId String @id

  /// "" | "date" | "importance"
  groupBy String @default("")
  /// "" | "date" | "importance"
  sortBy  String @default("")

  pomoWork     Int @default(25)
  pomoShort    Int @default(5)
  pomoLong     Int @default(15)
  pomoSessions Int @default(4)

  /// "work" | "short" | "long"
  pomoMode           String    @default("work")
  pomoRemaining      Int       @default(1500)
  pomoCurrentSession Int       @default(0)
  /// Set while the timer is running so a reload can recover the elapsed time
  /// instead of trusting a counter that stalls in a background tab.
  pomoRunningSince   DateTime?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
